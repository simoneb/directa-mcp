# Darwin listens locally once you're logged in with API access enabled
# (Sviluppatori > Dev kit in Darwin, disclaimer firmato su directatrading.com).
DIRECTA_TRADING_HOST=127.0.0.1
DIRECTA_TRADING_PORT=10002
DIRECTA_HISTORICAL_PORT=10003

# Safety switch for the order tools (place/modify/confirm/cancel). While false,
# they send nothing at all to Darwin and return success:false with blocked:true
# — there is no simulated fallback, so a blocked call can never be mistaken for
# an order that went through.
#
# Set this to true only when you intend to place REAL orders with REAL money.
# These are also the only tools in this server never verified against live
# Darwin: check the outcome with get_orders, not just the acknowledgement.
DIRECTA_ENABLE_ORDERS=false
