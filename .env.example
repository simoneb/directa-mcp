# Darwin listens locally once you're logged in with API access enabled
# (Sviluppatori > Dev kit in Darwin, disclaimer firmato su directatrading.com).
DIRECTA_TRADING_HOST=127.0.0.1
DIRECTA_TRADING_PORT=10002
DIRECTA_HISTORICAL_PORT=10003

# Safety switch. While false, place_limit_order always runs against Darwin's
# simulation mode regardless of what the caller asks for — no real order is
# sent. Only set to true once you've verified the tool against simulation
# mode and you understand it will place real orders with real money.
DIRECTA_LIVE_TRADING=false
